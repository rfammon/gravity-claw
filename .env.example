# ═══════════════════════════════════════════════════════════════════
# GRAVITY CLAW - CONFIGURATION FILE
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# Required fields are marked with [REQUIRED]
# ═══════════════════════════════════════════════════════════════════

# ─── TELEGRAM BOT ───────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ─── AI MODELS ──────────────────────────────────────────────────────
# OpenRouter API (Primary LLM)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API (Voice STT - Speech to Text)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SECURITY ───────────────────────────────────────────────────────
# Your Telegram user ID(s) - comma separated
# Find your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789

# Master key for encrypted secrets (auto-generated if not set)
# IMPORTANT: Save this key! You'll need it to decrypt your secrets
MASTER_KEY=

# ─── SUPABASE (CLOUD DATABASE) ──────────────────────────────────────
# Enable cloud memory synced across devices
# Get credentials at: https://supabase.com/dashboard
# 
# Project URL: Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Service Role Key: Settings > API > Project API keys > service_role
# ⚠️ WARNING: This key has admin access - keep it secret!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eHh4eHh4eHh4eHh4eCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAxNTAwMDAwMH0.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── MODAL (CODE SUB-AGENT) ─────────────────────────────────────────
# Optional: GLM-5 Code Agent for programming tasks
MODAL_BASE_URL=https://api.us-west-2.modal.direct/v1
MODAL_API_KEY=

# ─── OPENCODE ZEN (PRIMARY LLM FALLBACK) ────────────────────────────
# Optional: OpenCode LLM for programming tasks and chat
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_DEFAULT_MODEL=glm-5-free

# ─── OCR (COMPUTER VISION) ──────────────────────────────────────────
# Optional: Extract text from images
# Get key at: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# ─── TRELLO INTEGRATION ─────────────────────────────────────────────
# Optional: Task management
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# ─── WEB SEARCH ─────────────────────────────────────────────────────
# Optional: Tavily search API
TAVILY_API_KEY=

# ─── PERFORMANCE (ANDROID/LOW-RESOURCE) ─────────────────────────────
# Enable low resource mode for devices with < 2GB RAM
LOW_RESOURCE_MODE=false

# Maximum concurrent tool executions
MAX_CONCURRENT_TOOLS=4

# ─── PUTER (CODE AGENT FALLBACK) ────────────────────────────────────
# Default model for Puter AI (used when Modal fails)
# Options: moonshotai/kimi-k2.5, gpt-4o-mini, claude-3-haiku, etc.
PUTER_DEFAULT_MODEL=moonshotai/kimi-k2.5

# Puter authentication token (run: npx tsx scripts/puter-auth.ts to get)
PUTER_TOKEN=

# ─── OLLAMA (LOCAL LLM FALLBACK) ────────────────────────────────────
# Optional: Local LLM when offline
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
