# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=your_openrouter_key

# Groq (free Whisper STT for voice messages)
GROQ_API_KEY=your_groq_key

# Security: comma-separated Telegram user IDs
ALLOWED_USER_IDS=123456789

# Web Search (Tavily)
TAVILY_API_KEY=your_tavily_key

# Trello MCP
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_api_secret
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_board_id

# Modal (GLM-5 Code Sub-Agent) — Optional
MODAL_BASE_URL=https://api.us-west-2.modal.direct/v1
MODAL_API_KEY=your_modal_key

# OCR (Computer Vision) — Optional
OCR_SPACE_API_KEY=your_ocr_space_key

# Supabase (Cloud Database) — Optional, enables device-independent memory
# If not set, falls back to local SQLite
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
