{
    "name": "gravity-claw",
    "version": "1.1.0",
    "description": "Lean, secure personal AI agent — Telegram + agentic tool loop — Android/Linux compatible",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "start:android": "LOW_RESOURCE_MODE=true tsx src/index.ts",
        "check": "npx tsc --noEmit",
        "install:linux": "chmod +x scripts/install-linux.sh && ./scripts/install-linux.sh",
        "postinstall": "node scripts/postinstall.js 2>/dev/null || true"
    },
    "dependencies": {
        "@heyputer/puter.js": "^2.2.10",
        "@supabase/supabase-js": "^2.97.0",
        "@types/ws": "^8.18.1",
        "axios": "^1.13.5",
        "better-sqlite3": "^12.6.2",
        "croner": "^10.0.1",
        "cross-fetch": "^4.1.0",
        "dotenv": "^16.4.7",
        "edge-tts": "^1.0.1",
        "elevenlabs-node": "^2.0.3",
        "grammy": "^1.35.0",
        "groq-sdk": "^0.37.0",
        "@lancedb/lancedb": "^0.10.0",
        "node-cron": "^4.2.1",
        "node-edge-tts": "^1.2.10",
        "openai": "^6.22.0",
        "playwright": "^1.58.2",
        "sql.js": "^1.10.3",
        "tesseract.js": "^7.0.0",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.13.4",
        "pm2": "^6.0.14",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vitest": "^3.0.5"
    },
    "optionalDependencies": {
        "puppeteer": "^22.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "os": [
        "linux",
        "darwin",
        "win32",
        "android"
    ]
}
